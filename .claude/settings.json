{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go list *)",
      "Bash(go doc *)",
      "Bash(go mod tidy)",
      "Bash(gofmt *)",
      "Bash(golangci-lint run *)",
      "Bash(sqlc generate)",
      "Bash(sqlc vet)",
      "Bash(sqlc diff)",
      "Bash(make test*)",
      "Bash(make lint*)",
      "Bash(make build*)",
      "Bash(make generate*)"
    ],
    "ask": [
      "Bash(goose *)",
      "Bash(make migrate*)",
      "Bash(docker compose down *)",
      "Bash(temporal workflow terminate *)",
      "Bash(temporal workflow reset *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/kubeconfig*)",
      "Read(./configs/secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.go) gofmt -w \"$f\" ;; esac; } 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "gofmt"
          }
        ]
      }
    ]
  }
}
