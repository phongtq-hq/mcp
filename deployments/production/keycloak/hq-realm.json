{
  "realm": "hq",
  "enabled": true,
  "displayName": "HQ AI Platform",
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "hq-api",
      "name": "HQ Management API (resource server)",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "hq-gateway",
      "name": "HQ MCP Gateway (resource server)",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "hq-web",
      "name": "HQ web console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${HQ_APP_ORIGIN}/"
      ],
      "webOrigins": [
        "${HQ_APP_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${HQ_APP_ORIGIN}/"
      },
      "protocolMappers": [
        {
          "name": "hq-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "hq-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "hq-mcp",
      "name": "MCP client bên ngoài (Authorization Code + PKCE; token chỉ mang aud = hq-gateway)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "hq-gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "hq-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
